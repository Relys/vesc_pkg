    (led-rear-num              . (34 i 11))
    (led-rear-type             . (35 i 2))
    (led-rear-reversed         . (36 b 1))
    (led-rear-strip-type       . (37 b 0))
    (led-button-pin            . (38 b -1))
    (led-button-strip-type     . (39 b 0))
