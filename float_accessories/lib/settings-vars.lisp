    (bms-override-soc          . (52 i 0))
    (bms-rs485-chip            . (53 b 1))
    (bms-key-a                 . (54 i -1))
    (bms-key-b                 . (55 i -1))
    (bms-key-c                 . (56 i -1))
    (bms-key-d                 . (57 i -1))
    (bms-counter-a             . (58 i -1))
    (bms-counter-b             . (59 i -1))
    (bms-counter-c             . (60 i -1))
    (bms-counter-d             . (61 i -1))
    (led-loop-delay            . (62 i 20))
